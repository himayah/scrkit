// Settings dialog resource for the /c configuration screen (要件.txt §6, §9 Step 9).
#include <windows.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_SETTINGS DIALOGEX 0, 0, 260, 170
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Spiral Suction Saver - Settings"
FONT 9, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Particle count / 粒子数", -1, 7, 5, 246, 70

    LTEXT           "Preset:", -1, 15, 22, 40, 10
    COMBOBOX        IDC_PRESET_COMBO, 60, 20, 130, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Custom count:", IDC_CUSTOM_COUNT_LABEL, 15, 42, 60, 10
    EDITTEXT        IDC_CUSTOM_COUNT_EDIT, 80, 40, 60, 14, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "", IDC_GPU_INFO_STATIC, 15, 58, 230, 12

    GROUPBOX        "Background image / 背景画像", -1, 7, 80, 246, 55

    EDITTEXT        IDC_BG_PATH_EDIT, 15, 97, 175, 14, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Browse...", IDC_BG_BROWSE_BUTTON, 195, 96, 50, 16
    PUSHBUTTON      "Use system wallpaper", IDC_BG_USE_SYSTEM_BUTTON, 15, 115, 120, 14

    DEFPUSHBUTTON   "OK", IDOK, 130, 145, 55, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 190, 145, 55, 16
END
